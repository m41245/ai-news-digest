# ==========================================================
# Application
# ==========================================================

APP_NAME=AI News Digest
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# ==========================================================
# Database
# ==========================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_news_digest
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_STATEMENT_TIMEOUT=30000

# ==========================================================
# Redis
# ==========================================================

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50
REDIS_RETRY_ON_TIMEOUT=true
REDIS_RETRY_ON_CONNECTION_ERROR=true

# ==========================================================
# Celery
# ==========================================================

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================================
# Authentication
# ==========================================================

# Generate a secure random key: openssl rand -hex 32
# In development, a placeholder is accepted. In production/staging you MUST use a real random key.
JWT_SECRET_KEY=please-replace-with-openssl-rand-hex-32-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
BCRYPT_ROUNDS=12

# ==========================================================
# CORS
# ==========================================================
# Development defaults - replace with actual production origins in production

CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ==========================================================
# OpenAI
# ==========================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-4
OPENAI_PRIORITY=1
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# ==========================================================
# Anthropic
# ==========================================================

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ENABLED=false
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_PRIORITY=2
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3

DEFAULT_LLM_PROVIDER=openai

# ==========================================================
# AI Processing
# ==========================================================

AI_MAX_CONTENT_LENGTH=8000
AI_SUMMARIZATION_MAX_TOKENS=512
AI_SUMMARIZATION_TEMPERATURE=0.2
AI_CATEGORIZATION_MAX_TOKENS=64
AI_CATEGORIZATION_TEMPERATURE=0.1
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0
AI_RETRY_MAX_DELAY=10.0

# ==========================================================
# RSS
# ==========================================================

RSS_REQUEST_TIMEOUT=20
RSS_MAX_ARTICLES_PER_FEED=50

# ==========================================================
# Digest
# ==========================================================

DIGEST_TIMEZONE=UTC
DIGEST_SCHEDULE_HOUR=8
DIGEST_SCHEDULE_MINUTE=0
DIGEST_MAX_ARTICLES=50

# ==========================================================
# Email / SMTP
# ==========================================================

EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_DEVELOPMENT_MODE=true
EMAIL_BASE_URL=http://localhost:8000
EMAIL_FROM_ADDRESS=noreply@ai-news-digest.com
EMAIL_FROM_NAME=AI News Digest
EMAIL_REPLY_TO=
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=60
EMAIL_BATCH_SIZE=50
EMAIL_RATE_LIMIT=100
EMAIL_TIMEOUT=30

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-news-digest.com
EMAIL_RECIPIENTS=["recipient@example.com"]

# ==========================================================
# Logging
# ==========================================================

LOG_LEVEL=INFO

# ==========================================================
# Rate Limiting
# ==========================================================

RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=60
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
MAX_REQUEST_SIZE_BYTES=1048576
METRICS_ALLOWED_IPS=
