# ==========================================================
# Application
# ==========================================================

APP_NAME=AI News Digest
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

# ==========================================================
# Database
# ==========================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_news_digest

# ==========================================================
# Redis
# ==========================================================

REDIS_URL=redis://localhost:6379/0

# ==========================================================
# Celery
# ==========================================================

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================================
# Authentication
# ==========================================================

# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-secure-random-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ==========================================================
# OpenAI
# ==========================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-4
OPENAI_PRIORITY=1
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# ==========================================================
# Anthropic
# ==========================================================

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ENABLED=false
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_PRIORITY=2
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3

# ==========================================================
# AI Processing
# ==========================================================

AI_MAX_CONTENT_LENGTH=8000
AI_SUMMARIZATION_MAX_TOKENS=512
AI_SUMMARIZATION_TEMPERATURE=0.2
AI_CATEGORIZATION_MAX_TOKENS=64
AI_CATEGORIZATION_TEMPERATURE=0.1
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0
AI_RETRY_MAX_DELAY=10.0

# ==========================================================
# RSS
# ==========================================================

RSS_REQUEST_TIMEOUT=20
RSS_MAX_ARTICLES_PER_FEED=50

# ==========================================================
# Digest
# ==========================================================

DIGEST_TIMEZONE=UTC
DIGEST_SCHEDULE_HOUR=8
DIGEST_SCHEDULE_MINUTE=0

# ==========================================================
# Email / SMTP
# ==========================================================

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-news-digest.com
EMAIL_RECIPIENTS=["recipient@example.com"]

# ==========================================================
# Logging
# ==========================================================

LOG_LEVEL=INFO

# ==========================================================
# Rate Limiting
# ==========================================================

RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
